# Copy to .env and adjust. .env is gitignored; this file is not.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=3001

# --- Database --------------------------------------------------------------
# REQUIRED — the API exits at startup without it, and drizzle-kit reads it too.
# Must match the POSTGRES_* values below, which docker-compose.yml reads.
DATABASE_URL=postgresql://expense:expense@localhost:5432/expense_tracker

POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# --- Auth ------------------------------------------------------------------
# REQUIRED — signs session cookies, minimum 32 characters. The API exits at
# startup without it. Generate your own; never reuse this placeholder:
#   npx auth@latest secret
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# The origin the BROWSER talks to — the Vite dev server in development, since it
# proxies /api to Express. In production this is the single origin Express serves
# both the SPA and the API from. Optional; defaults to the value below.
BETTER_AUTH_URL=http://localhost:5173

# Express `trust proxy`, which decides what `req.ip` resolves to. That address
# is what the sign-in rate limiter buckets on, so getting it wrong means one
# caller can lock out every user.
#   unset  — nothing in front of Express; uses the socket peer, unforgeable.
#   1      — exactly one proxy hop (typical single load balancer).
#   a list — proxy addresses/subnets, e.g. 10.0.0.0/24, or a preset like loopback.
# Only set `true` if the origin is unreachable except through your proxy: it
# trusts whatever X-Forwarded-For says.
# TRUST_PROXY=1

# Lets a production build run over plain http, which issues session cookies
# WITHOUT `Secure`. Local smoke-testing of the prod bundle only — never deployed.
# Without it, NODE_ENV=production requires an https BETTER_AUTH_URL.
# ALLOW_INSECURE_COOKIES=true
