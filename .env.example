# Copy to .env and adjust. .env is gitignored; this file is not.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Port the Express API listens on. The Vite dev server proxies /api here.
PORT=3001

# --- Database --------------------------------------------------------------
# Must match the POSTGRES_* values below, which docker-compose.yml reads.
DATABASE_URL=postgresql://expense:expense@localhost:5432/expense_tracker

POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432

# --- Auth ------------------------------------------------------------------
# Added in the Better Auth slice; nothing reads these yet.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:5173
